# DIGI Hub — CCTV & Network Solutions Environment Configuration
# GEMINI_API_KEY: Optional AI assistant / smart diagnostics
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# JWT Secrets for Authentication
JWT_SECRET="digihub-super-secret-jwt-key-2026"
JWT_REFRESH_SECRET="digihub-refresh-token-secret-key-2026"

# Database Connection (PostgreSQL for production deployment)
DATABASE_URL="postgresql://digihub_user:digihub_password@localhost:5432/digihub_db?schema=public"

# File / Object Storage (S3 / Supabase / MinIO)
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="digihub-attachments"
STORAGE_ACCESS_KEY="my-access-key"
STORAGE_SECRET_KEY="my-secret-key"

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID="digihub-cctv"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@digihub-cctv.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...==\n-----END PRIVATE KEY-----"

# Notification & Communication Integrations
EMAIL_SMTP_HOST="smtp.mailtrap.io"
EMAIL_SMTP_PORT="587"
EMAIL_USER="support@digihub.com"
EMAIL_PASS="supersecret"
WHATSAPP_BUSINESS_NUMBER="+15550198822"
WHATSAPP_API_TOKEN="wa_token_digihub_secure"

# Mapping & CCTV RTSP/ONVIF Gateway
GOOGLE_MAPS_API_KEY="AIzaSyDummyMapsKeyForDev"
CCTV_MEDIA_GATEWAY_URL="rtsp://gateway.digihub.internal:8554/live"

